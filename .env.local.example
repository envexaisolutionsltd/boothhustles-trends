# Next.js app (safe to expose to the browser, except OPENAI_API_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Used by the /api/agent route (server-side only)
OPENAI_API_KEY=your-openai-api-key

# Set these as Supabase Edge Function secrets, NOT here:
#   supabase secrets set SERPAPI_KEY=your-serpapi-key
#   supabase secrets set EBAY_CLIENT_ID=your-ebay-client-id
#   supabase secrets set EBAY_CLIENT_SECRET=your-ebay-client-secret
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into edge functions by Supabase, you don't need to set them yourself.

# ---------------------------------------------------------------------------
# AZOTEA website (/azotea)
# ---------------------------------------------------------------------------
# Canonical origin used for metadata, sitemap.xml and robots.txt.
# Defaults to https://azotea.co.uk when unset.
NEXT_PUBLIC_SITE_URL=https://azotea.co.uk

# Enquiry form delivery (server-side only). Without RESEND_API_KEY *and*
# ENQUIRY_FROM_EMAIL the enquiry forms validate and log the submission, and
# tell the visitor that email delivery isn't configured — they never claim a
# message was sent when it wasn't.
RESEND_API_KEY=your-resend-api-key
ENQUIRY_FROM_EMAIL=website@your-verified-domain.co.uk
# Optional override — defaults to hola@azotea.co.uk, or groups@azotea.co.uk
# for group enquiries.
ENQUIRY_TO_EMAIL=hola@azotea.co.uk
