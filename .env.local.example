# Next.js app (safe to expose to the browser, except OPENAI_API_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Used by the /api/agent route (server-side only)
OPENAI_API_KEY=your-openai-api-key

# Set this as a Supabase Edge Function secret, NOT here:
#   supabase secrets set SERPAPI_KEY=your-serpapi-key
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into edge functions by Supabase, you don't need to set them yourself.
